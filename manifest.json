{
  "manifest_version": 3,
  "name": "VN SafePost Copilot",
  "version": "1.0.0",
  "description": "Privacy-first ethical & legal guardrail assistant for Facebook posts in Vietnam.",
  "permissions": [
    "storage",
    "offscreen"
  ],
  "host_permissions": [
    "https://*.facebook.com/*"
  ],
  "background": {
    "service_worker": "background/background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    },
    "default_title": "VN SafePost Copilot"
  },
  "icons": {
    "16": "assets/icons/icon16.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.facebook.com/*"
      ],
      "js": [
        "core/i18n.js",
        "core/case-corpus.js",
        "core/rules.js",
        "core/gemini.js",
        "core/corpus-matcher.js",
        "content/content.js"
      ],
      "css": [
        "content/styles.css"
      ],
      "run_at": "document_end",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/icons/*",
        "core/case-corpus.json"
      ],
      "matches": [
        "https://*.facebook.com/*"
      ]
    }
  ]
}
